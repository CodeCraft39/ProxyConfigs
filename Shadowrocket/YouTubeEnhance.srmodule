#!name=YouTube (Music) Enhance
#!desc=YouTube and YouTube Music enhancements with local or relay playback processing
#!openUrl=https://raw.githubusercontent.com/CodeCraft39/ProxyConfigs/main/Shadowrocket/YouTubeEnhance.srmodule
#!arguments=PlaybackMode:local,HideUpload:true,HideMusicSamples:true,HideShorts:false,CaptionLanguage:off,Debug:false
#!arguments-desc=PlaybackMode accepts local (on-device processing) or relay (configured Cloudflare Worker). Local is the default; save private relay credentials before selecting relay.\nHideUpload, HideMusicSamples, HideShorts and Debug accept true or false.\nCaptionLanguage: target YouTube caption language code, such as en, zh-Hans or zh-Hant. Use off to disable automatic translation.\nHideMusicSamples controls the YouTube Music Samples tab.\nDebug enables processing logs and is off by default.

# CaptionLanguage: target YouTube caption language code, such as en, zh-Hans or zh-Hant.
# Use off to disable automatic translation.
# Change all settings together using the module settings editor.
# Disable overlapping YouTube modules before enabling this module.
# PlaybackMode remains switchable; native Relay is a separate experimental candidate.
[Script]
# YouTube API responses
youtube.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player(?:/ad_break)?|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch|log_event|config)(?:\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,engine=webview,script-path=https://raw.githubusercontent.com/CodeCraft39/ProxyConfigs/main/Script/Youtube/youtube.response.js,argument="{"captionLang":"{{{CaptionLanguage}}}","blockUpload":"{{{HideUpload}}}","blockImmersive":"{{{HideMusicSamples}}}","blockShorts":"{{{HideShorts}}}","debug":"{{{Debug}}}","playbackMode":"{{{PlaybackMode}}}"}"

# YouTube playback requests
# Local mode filters Google responses on-device; relay mode returns the response processed by the configured relay Worker.
youtube.init.request = type=http-request,timeout=30,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback\?(?:[^#]*&)?ack(?:=|&|$),requires-body=1,max-size=-1,binary-body-mode=1,engine=webview,script-path=https://raw.githubusercontent.com/CodeCraft39/ProxyConfigs/main/Script/Youtube/youtube.request.js,argument="{"captionLang":"{{{CaptionLanguage}}}","blockUpload":"{{{HideUpload}}}","blockImmersive":"{{{HideMusicSamples}}}","blockShorts":"{{{HideShorts}}}","debug":"{{{Debug}}}","playbackMode":"{{{PlaybackMode}}}"}"

# YouTube event request headers
youtube.event = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event(?:\?.*)?$,requires-body=0,script-path=https://raw.githubusercontent.com/CodeCraft39/ProxyConfigs/main/Script/Youtube/youtube.request.js,argument="{"captionLang":"{{{CaptionLanguage}}}","blockUpload":"{{{HideUpload}}}","blockImmersive":"{{{HideMusicSamples}}}","blockShorts":"{{{HideShorts}}}","debug":"{{{Debug}}}","playbackMode":"{{{PlaybackMode}}}"}"

# YouTube playback responses
# Filter local playback responses; relay responses have already been processed.
youtube.init.response = type=http-response,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback\?(?:[^#]*&)?ack(?:=|&|$),requires-body=1,max-size=-1,binary-body-mode=1,engine=webview,script-path=https://raw.githubusercontent.com/CodeCraft39/ProxyConfigs/main/Script/Youtube/youtube.response.js,argument="{"captionLang":"{{{CaptionLanguage}}}","blockUpload":"{{{HideUpload}}}","blockImmersive":"{{{HideMusicSamples}}}","blockShorts":"{{{HideShorts}}}","debug":"{{{Debug}}}","playbackMode":"{{{PlaybackMode}}}"}"

# Private relay settings, handled locally by the script.
# Relay mode requires a configured Worker URL and valid token.
# With this proxy app and MITM enabled, open this settings page
# in a web browser on the same device:
# https://youtube-enhance-relay-staging.hermanworkstk.workers.dev/__youtube_enhance/settings
# Set the "Worker endpoint" field to:
# https://youtube-enhance-relay-staging.hermanworkstk.workers.dev/v1/initplayback
# Enter a valid relay token and save before selecting relay mode.
# Never put credentials in shared configurations or script URLs.
youtube.settings = type=http-request,pattern=^https:\/\/youtube-enhance-relay-staging\.hermanworkstk\.workers\.dev\/__youtube_enhance\/settings(?:\?.*)?$,requires-body=1,max-size=8192,binary-body-mode=1,engine=webview,script-path=https://raw.githubusercontent.com/CodeCraft39/ProxyConfigs/main/Script/Youtube/youtube.request.js

# YouTube HTTPS hosts and private relay settings host
[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com, youtube-enhance-relay-staging.hermanworkstk.workers.dev
