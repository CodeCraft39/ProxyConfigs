#!name=YouTube (Music) Enhance - Native Relay (Experimental)
#!desc=Experimental native relay delivery; response matching and playback acceptance are pending
#!openUrl=https://raw.githubusercontent.com/CodeCraft39/ProxyConfigs/main/Shadowrocket/YouTubeEnhanceRelay.srmodule
#!arguments=HideUpload:true,HideMusicSamples:true,HideShorts:false,CaptionLanguage:off,Debug:false
#!arguments-desc=HideUpload, HideMusicSamples, HideShorts and Debug accept true or false.\nCaptionLanguage: target YouTube caption language code, such as en, zh-Hans or zh-Hant. Use off to disable automatic translation.\nHideMusicSamples controls the YouTube Music Samples tab.\nDebug enables processing logs and is off by default.

# CaptionLanguage: target YouTube caption language code, such as en, zh-Hans or zh-Hant.
# Use off to disable automatic translation.
# Change all settings together using the module settings editor.
# Enable only one YouTube Enhance module at a time.
# Relay requires a configured Worker URL and valid private token.
# For normal Local or buffered Relay playback, use YouTubeEnhance.srmodule.
# Keep this candidate disabled until a separately planned native Relay device trial.
# Response-rule matching and guard URL exposure must both be verified first.
[Script]
# YouTube API responses
youtube.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player(?:/ad_break)?|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch|log_event|config)(?:\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,engine=webview,script-path=https://raw.githubusercontent.com/CodeCraft39/ProxyConfigs/main/Script/Youtube/youtube.response.js,argument="{"captionLang":"{{{CaptionLanguage}}}","blockUpload":"{{{HideUpload}}}","blockImmersive":"{{{HideMusicSamples}}}","blockShorts":"{{{HideShorts}}}","debug":"{{{Debug}}}","playbackMode":"relay","relayTransport":"native"}"

# YouTube playback requests
# Validate the request and hand its binary body and metadata to native networking.
# The host-selected request engine supports the tested cross-host rewrite.
# Keep relayTransport=native with this module; use the Local module to switch modes.
youtube.init.request = type=http-request,timeout=30,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback\?(?:[^#]*&)?ack(?:=|&|$),requires-body=1,max-size=-1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/CodeCraft39/ProxyConfigs/main/Script/Youtube/youtube.request.js,argument="{"captionLang":"{{{CaptionLanguage}}}","blockUpload":"{{{HideUpload}}}","blockImmersive":"{{{HideMusicSamples}}}","blockShorts":"{{{HideShorts}}}","debug":"{{{Debug}}}","playbackMode":"relay","relayTransport":"native"}"

# YouTube event request headers
youtube.event = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event(?:\?.*)?$,requires-body=0,script-path=https://raw.githubusercontent.com/CodeCraft39/ProxyConfigs/main/Script/Youtube/youtube.request.js,argument="{"captionLang":"{{{CaptionLanguage}}}","blockUpload":"{{{HideUpload}}}","blockImmersive":"{{{HideMusicSamples}}}","blockShorts":"{{{HideShorts}}}","debug":"{{{Debug}}}","playbackMode":"relay","relayTransport":"native"}"

# Relay response headers
# No full-body playback-response hook: filtering and stream bounds stay in the Worker.
youtube.relay.response = type=http-response,pattern=^https:\/\/youtube-enhance-relay-staging\.hermanworkstk\.workers\.dev\/v1\/initplayback$,requires-body=0,script-path=https://raw.githubusercontent.com/CodeCraft39/ProxyConfigs/main/Script/Youtube/youtube.response.js,argument="{"captionLang":"{{{CaptionLanguage}}}","blockUpload":"{{{HideUpload}}}","blockImmersive":"{{{HideMusicSamples}}}","blockShorts":"{{{HideShorts}}}","debug":"{{{Debug}}}","playbackMode":"relay","relayTransport":"native"}"

# Private relay settings, handled locally by the script.
# Relay mode requires a configured Worker URL and valid token.
# With this proxy app and MITM enabled, open this settings page
# in a web browser on the same device:
# https://youtube-enhance-relay-staging.hermanworkstk.workers.dev/__youtube_enhance/settings
# Set the "Worker endpoint" field to:
# https://youtube-enhance-relay-staging.hermanworkstk.workers.dev/v1/initplayback
# Enter a valid relay token and save before enabling the Relay module.
# Never put credentials in shared configurations or script URLs.
youtube.settings = type=http-request,pattern=^https:\/\/youtube-enhance-relay-staging\.hermanworkstk\.workers\.dev\/__youtube_enhance\/settings(?:\?.*)?$,requires-body=1,max-size=8192,binary-body-mode=1,engine=webview,script-path=https://raw.githubusercontent.com/CodeCraft39/ProxyConfigs/main/Script/Youtube/youtube.request.js

# YouTube HTTPS hosts and private relay settings host
[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com, youtube-enhance-relay-staging.hermanworkstk.workers.dev
