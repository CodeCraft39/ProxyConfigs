#!name=YouTube Relay Redirect Probe
#!desc=Temporary default/JSC/WebView and body-hook rewrite matrix using public fixtures only
#!openUrl=https://raw.githubusercontent.com/CodeCraft39/ProxyConfigs/main/Diagnostics/YouTubeEnhance/YouTubeRelayRedirectProbe.srmodule

# No YouTube rules, real credentials, cache writes or response-body hooks.
# Create the separate diagnostic Worker before running the page.
# Open https://example.com/yt-relay-redirect-probe in a browser on the same device.
# Disable this temporary module after testing.
# Client redirect-probe-20261110.3; the deployed Worker remains redirect-probe-20261110.1.
# Refresh both this module and its script. Each variant verifies its rule argument first.
# Body-enabled variants match Maasea's requires-body=1,binary-body-mode=1 combination.
[Script]
youtube.redirect.page = type=http-request,pattern=^https:\/\/example\.com\/yt-relay-redirect-probe(?:\?.*)?$,requires-body=0,engine=webview,script-path=https://raw.githubusercontent.com/CodeCraft39/ProxyConfigs/main/Diagnostics/YouTubeEnhance/relay-redirect-probe.js

# Host-selected engine: leave engine unspecified, as in Maasea's module.
youtube.redirect.default.body0 = type=http-request,pattern=^https:\/\/example\.com\/yt-relay-redirect-probe/run/default-body0/(ready|url-only|url-headers|bad-token|binary-response)(?:\?.*)?$,requires-body=0,script-path=https://raw.githubusercontent.com/CodeCraft39/ProxyConfigs/main/Diagnostics/YouTubeEnhance/relay-redirect-probe.js,argument="{"variant":"default-body0","probeBuild":"redirect-probe-20261110.3"}"
youtube.redirect.default.body1 = type=http-request,pattern=^https:\/\/example\.com\/yt-relay-redirect-probe/run/default-body1/(ready|url-only|url-headers|bad-token|binary-response)(?:\?.*)?$,requires-body=1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/CodeCraft39/ProxyConfigs/main/Diagnostics/YouTubeEnhance/relay-redirect-probe.js,argument="{"variant":"default-body1","probeBuild":"redirect-probe-20261110.3"}"

# Explicit JavaScriptCore engine.
youtube.redirect.jsc.body0 = type=http-request,pattern=^https:\/\/example\.com\/yt-relay-redirect-probe/run/jsc-body0/(ready|url-only|url-headers|bad-token|binary-response)(?:\?.*)?$,requires-body=0,engine=jsc,script-path=https://raw.githubusercontent.com/CodeCraft39/ProxyConfigs/main/Diagnostics/YouTubeEnhance/relay-redirect-probe.js,argument="{"variant":"jsc-body0","probeBuild":"redirect-probe-20261110.3"}"
youtube.redirect.jsc.body1 = type=http-request,pattern=^https:\/\/example\.com\/yt-relay-redirect-probe/run/jsc-body1/(ready|url-only|url-headers|bad-token|binary-response)(?:\?.*)?$,requires-body=1,binary-body-mode=1,engine=jsc,script-path=https://raw.githubusercontent.com/CodeCraft39/ProxyConfigs/main/Diagnostics/YouTubeEnhance/relay-redirect-probe.js,argument="{"variant":"jsc-body1","probeBuild":"redirect-probe-20261110.3"}"

# Explicit WebView engine; body0 is the configuration used in the first native run.
youtube.redirect.webview.body0 = type=http-request,pattern=^https:\/\/example\.com\/yt-relay-redirect-probe/run/webview-body0/(ready|url-only|url-headers|bad-token|binary-response)(?:\?.*)?$,requires-body=0,engine=webview,script-path=https://raw.githubusercontent.com/CodeCraft39/ProxyConfigs/main/Diagnostics/YouTubeEnhance/relay-redirect-probe.js,argument="{"variant":"webview-body0","probeBuild":"redirect-probe-20261110.3"}"
youtube.redirect.webview.body1 = type=http-request,pattern=^https:\/\/example\.com\/yt-relay-redirect-probe/run/webview-body1/(ready|url-only|url-headers|bad-token|binary-response)(?:\?.*)?$,requires-body=1,binary-body-mode=1,engine=webview,script-path=https://raw.githubusercontent.com/CodeCraft39/ProxyConfigs/main/Diagnostics/YouTubeEnhance/relay-redirect-probe.js,argument="{"variant":"webview-body1","probeBuild":"redirect-probe-20261110.3"}"

[MITM]
hostname = %APPEND% example.com
