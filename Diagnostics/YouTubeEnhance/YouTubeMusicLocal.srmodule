#!name=YouTube Music Local Recovery Test
#!desc=Temporary local playback and one-shot missing-key diagnostic; disable other YouTube modules
# Temporary device test; production scripts are pinned to a verified public commit.
# Play/pause a Music track, then open the local arm URL with ?app=music.
# https://example.com/yt-local-capture/bootstrap-probe/arm?app=music
# Status must report app=youtubeMusic and playbackMode=local after selection.
# Controls expose no keys, bodies, URLs or relay credentials.

[Script]
# YouTube API responses
youtube.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player(?:/ad_break)?|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch|log_event|config)(?:\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,engine=webview,script-path=https://raw.githubusercontent.com/CodeCraft39/ProxyConfigs/1d3de9bfe7f188e1d1c937f6d29536e69d6863f2/Script/Youtube/youtube.response.js,argument="{"captionLang":"off","blockUpload":true,"blockImmersive":true,"blockShorts":false,"debug":true,"playbackMode":"local"}"

# Local playback requests with the opt-in missing-key probe
youtube.init.request = type=http-request,timeout=30,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback\?(?:[^#]*&)?ack(?:=|&|$),requires-body=1,max-size=-1,binary-body-mode=1,engine=webview,script-path=https://raw.githubusercontent.com/CodeCraft39/ProxyConfigs/main/Diagnostics/YouTubeEnhance/bootstrap-probe.js,argument="{"captionLang":"off","blockUpload":true,"blockImmersive":true,"blockShorts":false,"debug":true,"playbackMode":"local"}"

# YouTube event requests: acquire configuration through the production script
youtube.event = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event(?:\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,engine=webview,script-path=https://raw.githubusercontent.com/CodeCraft39/ProxyConfigs/1d3de9bfe7f188e1d1c937f6d29536e69d6863f2/Script/Youtube/youtube.request.js,argument="{"captionLang":"off","blockUpload":true,"blockImmersive":true,"blockShorts":false,"debug":true,"playbackMode":"local"}"

# Local playback responses: production filtering
youtube.init.response = type=http-response,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback\?(?:[^#]*&)?ack(?:=|&|$),requires-body=1,max-size=-1,binary-body-mode=1,engine=webview,script-path=https://raw.githubusercontent.com/CodeCraft39/ProxyConfigs/1d3de9bfe7f188e1d1c937f6d29536e69d6863f2/Script/Youtube/youtube.response.js,argument="{"captionLang":"off","blockUpload":true,"blockImmersive":true,"blockShorts":false,"debug":true,"playbackMode":"local"}"

# Temporary local controls: GET arm/status/cancel; no key export
youtube.bootstrap.control = type=http-request,pattern=^https:\/\/example\.com\/yt-local-capture\/bootstrap-probe\/(arm|status|cancel)(?:\?.*)?$,engine=webview,script-path=https://raw.githubusercontent.com/CodeCraft39/ProxyConfigs/main/Diagnostics/YouTubeEnhance/bootstrap-probe.js

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com, example.com
