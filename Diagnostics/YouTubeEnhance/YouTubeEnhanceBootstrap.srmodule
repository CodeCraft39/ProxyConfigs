#!name=YouTube Enhance Missing-Key Recovery Test
#!desc=Temporary one-shot local recovery diagnostic; disable other YouTube modules
# Temporary public test module; remove from the active configuration after testing.
# No traffic, key export or relay service is used by the controls.

[Script]
# YouTube API responses: production processing with English captions
youtube.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player(?:/ad_break)?|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch|log_event|config)(?:\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,engine=webview,script-path=https://raw.githubusercontent.com/CodeCraft39/ProxyConfigs/93c628e96ba56d09e14fc480af8ea2e2a9258966/Script/Youtube/youtube.response.js,argument="{"captionLang":"en","blockUpload":true,"blockImmersive":true,"blockShorts":false,"debug":true,"playbackMode":"local"}"

# YouTube playback requests: one-shot diagnostic wrapping the production script
youtube.init.request = type=http-request,timeout=30,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback\?(?:[^#]*&)?ack(?:=|&|$),requires-body=1,max-size=-1,binary-body-mode=1,engine=webview,script-path=https://raw.githubusercontent.com/CodeCraft39/ProxyConfigs/main/Diagnostics/YouTubeEnhance/bootstrap-probe.js,argument="{"captionLang":"en","blockUpload":true,"blockImmersive":true,"blockShorts":false,"debug":true,"playbackMode":"local"}"

# YouTube event requests: acquire configuration through the production script
youtube.event = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event(?:\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,engine=webview,script-path=https://raw.githubusercontent.com/CodeCraft39/ProxyConfigs/93c628e96ba56d09e14fc480af8ea2e2a9258966/Script/Youtube/youtube.request.js,argument="{"captionLang":"en","blockUpload":true,"blockImmersive":true,"blockShorts":false,"debug":true,"playbackMode":"local"}"

# YouTube playback responses: production local filtering
youtube.init.response = type=http-response,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback\?(?:[^#]*&)?ack(?:=|&|$),requires-body=1,max-size=-1,binary-body-mode=1,engine=webview,script-path=https://raw.githubusercontent.com/CodeCraft39/ProxyConfigs/93c628e96ba56d09e14fc480af8ea2e2a9258966/Script/Youtube/youtube.response.js,argument="{"captionLang":"en","blockUpload":true,"blockImmersive":true,"blockShorts":false,"debug":true,"playbackMode":"local"}"

# Temporary local controls: GET arm/status/cancel; example.com is intercepted
youtube.bootstrap.control = type=http-request,pattern=^https:\/\/example\.com\/yt-local-capture\/bootstrap-probe\/(arm|status|cancel)(?:\?.*)?$,engine=webview,script-path=https://raw.githubusercontent.com/CodeCraft39/ProxyConfigs/main/Diagnostics/YouTubeEnhance/bootstrap-probe.js

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com, example.com
