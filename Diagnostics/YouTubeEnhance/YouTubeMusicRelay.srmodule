#!name=YouTube Music Relay Recovery Test
#!desc=Temporary relay playback and one-shot missing-key diagnostic; disable other YouTube modules
# Temporary device test; production scripts are pinned to a verified public commit.
# Play/pause a Music track, then open the local arm URL with ?app=music.
# https://example.com/yt-local-capture/bootstrap-probe/arm?app=music
# Status must report app=youtubeMusic and playbackMode=relay after selection.
# Save valid private relay settings in Shadowrocket before the trial.
# Controls expose no keys, bodies, URLs or relay credentials.

[Script]
# YouTube API responses
youtube.response = type=http-response,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player(?:/ad_break)?|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch|log_event|config)(?:\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,engine=webview,script-path=https://raw.githubusercontent.com/CodeCraft39/ProxyConfigs/1d3de9bfe7f188e1d1c937f6d29536e69d6863f2/Script/Youtube/youtube.response.js,argument="{"captionLang":"off","blockUpload":true,"blockImmersive":true,"blockShorts":false,"debug":true,"playbackMode":"relay"}"

# Relay playback requests with the opt-in missing-key probe
youtube.init.request = type=http-request,timeout=30,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback\?(?:[^#]*&)?ack(?:=|&|$),requires-body=1,max-size=-1,binary-body-mode=1,engine=webview,script-path=https://raw.githubusercontent.com/CodeCraft39/ProxyConfigs/main/Diagnostics/YouTubeEnhance/bootstrap-probe.js,argument="{"captionLang":"off","blockUpload":true,"blockImmersive":true,"blockShorts":false,"debug":true,"playbackMode":"relay"}"

# YouTube event requests: acquire configuration through the production script
youtube.event = type=http-request,pattern=^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event(?:\?.*)?$,requires-body=1,max-size=-1,binary-body-mode=1,engine=webview,script-path=https://raw.githubusercontent.com/CodeCraft39/ProxyConfigs/1d3de9bfe7f188e1d1c937f6d29536e69d6863f2/Script/Youtube/youtube.request.js,argument="{"captionLang":"off","blockUpload":true,"blockImmersive":true,"blockShorts":false,"debug":true,"playbackMode":"relay"}"

# Playback responses have already been processed by the relay
youtube.init.response = type=http-response,pattern=^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback\?(?:[^#]*&)?ack(?:=|&|$),requires-body=1,max-size=-1,binary-body-mode=1,engine=webview,script-path=https://raw.githubusercontent.com/CodeCraft39/ProxyConfigs/1d3de9bfe7f188e1d1c937f6d29536e69d6863f2/Script/Youtube/youtube.response.js,argument="{"captionLang":"off","blockUpload":true,"blockImmersive":true,"blockShorts":false,"debug":true,"playbackMode":"relay"}"

# Temporary local controls: GET arm/status/cancel; no key export
youtube.bootstrap.control = type=http-request,pattern=^https:\/\/example\.com\/yt-local-capture\/bootstrap-probe\/(arm|status|cancel)(?:\?.*)?$,engine=webview,script-path=https://raw.githubusercontent.com/CodeCraft39/ProxyConfigs/main/Diagnostics/YouTubeEnhance/bootstrap-probe.js

# Private relay settings, handled locally; never put credentials in arguments
youtube.settings = type=http-request,pattern=^https:\/\/youtube-enhance-relay-staging\.hermanworkstk\.workers\.dev\/__youtube_enhance\/settings(?:\?.*)?$,requires-body=1,max-size=8192,binary-body-mode=1,engine=webview,script-path=https://raw.githubusercontent.com/CodeCraft39/ProxyConfigs/1d3de9bfe7f188e1d1c937f6d29536e69d6863f2/Script/Youtube/youtube.request.js

[MITM]
hostname = %APPEND% *.googlevideo.com, youtubei.googleapis.com, example.com, youtube-enhance-relay-staging.hermanworkstk.workers.dev
