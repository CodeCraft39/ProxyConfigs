# YouTube Enhance
# YouTube and YouTube Music enhancements with local or relay playback processing.
# Import as a rewrite resource and disable overlapping YouTube rewrites.
# Settings: hide Upload and YouTube Music Samples; keep Shorts; caption translation and debug off.
# playbackMode=local is the default. Set all three YouTube rules to playbackMode=relay to use the configured relay Worker.
# Keep common URL parameters consistent across all three YouTube rules.
# blockImmersive controls the YouTube Music Samples tab.
# captionLang: target YouTube caption language code, such as en, zh-Hans or zh-Hant.
# Use off to disable automatic translation.

# YouTube API responses
^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/(browse|next|player(?:/ad_break)?|search|reel/reel_watch_sequence|guide|account/get_setting|get_watch|log_event|config)(?:\?.*)?$ url script-response-body https://raw.githubusercontent.com/CodeCraft39/ProxyConfigs/main/Script/Youtube/youtube.response.js#playbackMode=local&blockUpload=true&blockImmersive=true&blockShorts=false&captionLang=off&debug=false

# YouTube playback requests and responses
# Local mode fetches/filters on-device; relay mode returns the response processed by the configured relay Worker.
# Save the Worker URL and token privately at the settings page below before selecting relay.
^https?:\/\/[\w-]+\.googlevideo\.com\/initplayback\?(?:[^#]*&)?ack(?:=|&|$) url script-analyze-echo-response https://raw.githubusercontent.com/CodeCraft39/ProxyConfigs/main/Script/Youtube/youtube.request.js#playbackMode=local&blockUpload=true&blockImmersive=true&blockShorts=false&captionLang=off&debug=false&qxEcho=true

# YouTube event request headers
^https:\/\/youtubei\.googleapis\.com\/youtubei\/v1\/log_event(?:\?.*)?$ url script-request-header https://raw.githubusercontent.com/CodeCraft39/ProxyConfigs/main/Script/Youtube/youtube.request.js#playbackMode=local&blockUpload=true&blockImmersive=true&blockShorts=false&captionLang=off&debug=false

# Private relay settings, handled locally by the script. Never put tokens in script URLs.
# Open https://youtube-enhance-relay-staging.hermanworkstk.workers.dev/__youtube_enhance/settings in Safari with Quantumult X enabled.
^https:\/\/youtube-enhance-relay-staging\.hermanworkstk\.workers\.dev\/__youtube_enhance\/settings(?:\?.*)?$ url script-analyze-echo-response https://raw.githubusercontent.com/CodeCraft39/ProxyConfigs/main/Script/Youtube/youtube.request.js

# YouTube HTTPS hosts and the owned settings origin
hostname = *.googlevideo.com, youtubei.googleapis.com, youtube-enhance-relay-staging.hermanworkstk.workers.dev
